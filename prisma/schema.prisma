// TLDCompare — Prisma Schema
// All pricing is DEMO / SAMPLE DATA unless connected to live sources.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TldType {
  GTLD
  CCTLD
  NEW_GTLD
  SPONSORED
  GEOGRAPHIC
  GENERIC
  IDN
}

enum TldStatus {
  ACTIVE
  PRE_LAUNCH
  SUNRISE
  LANDRUSH
  GA
  CLOSED
  PLANNED
}

enum AvailabilityStatus {
  AVAILABLE
  TAKEN
  PREMIUM
  RESTRICTED
  UNKNOWN
  API_ERROR
}

enum DataConfidence {
  VERIFIED
  AUTOMATED
  MANUAL
  STALE
  FAILED
  UNKNOWN
  DEMO
}

enum PriceType {
  REGISTRATION
  RENEWAL
  TRANSFER
  REDEMPTION
  RESTORE
  PRIVACY
  EMAIL
  PROMO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  alerts        Alert[]
  savedDomains  SavedDomain[]
  apiKeys       ApiKey[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Tld {
  id                        String      @id @default(cuid())
  extension                 String      @unique // com, ai, io
  unicodeExtension          String?
  name                      String      // .COM Domain Extension
  type                      TldType     @default(GTLD)
  registry                  String?
  registryUrl               String?
  country                   String?
  countryCode               String?
  description               String?     @db.Text
  intendedUse               String?     @db.Text
  launchDate                DateTime?
  status                    TldStatus   @default(ACTIVE)
  isIdn                     Boolean     @default(false)
  language                  String?
  script                    String?
  whoisPrivacy              Boolean     @default(true)
  dnssec                    Boolean     @default(true)
  emailForwarding           Boolean     @default(true)
  urlForwarding             Boolean     @default(true)
  trusteeRequired           Boolean     @default(false)
  registrationRestrictions  String?     @db.Text
  minimumRegistrationYears  Int         @default(1)
  maximumRegistrationYears  Int         @default(10)
  popularityScore           Int?        // null = unavailable
  isDemo                    Boolean     @default(true)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  categories                TldCategoryRelation[]
  pricing                   Pricing[]
  priceHistory              PriceHistory[]
  registrarTlds             RegistrarTld[]
  launches                  TldLaunch[]
  idnDetails                IdnTld?

  @@index([extension])
  @@index([type])
  @@index([status])
  @@index([isIdn])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tlds        TldCategoryRelation[]
}

model TldCategoryRelation {
  tldId      String
  categoryId String
  tld        Tld      @relation(fields: [tldId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([tldId, categoryId])
}

model Registrar {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  website           String?
  logoUrl           String?
  description       String?  @db.Text
  supportEmail      String?
  supportUrl        String?
  whoisPrivacy      Boolean  @default(true)
  dnsManagement     Boolean  @default(true)
  dnssec            Boolean  @default(true)
  emailForwarding   Boolean  @default(true)
  urlForwarding     Boolean  @default(true)
  apiAvailable      Boolean  @default(false)
  affiliateUrl      String?
  trackingId        String?
  isDemo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pricing           Pricing[]
  priceHistory      PriceHistory[]
  registrarTlds     RegistrarTld[]
  promotions        Promotion[]
  features          RegistrarFeature[]
  affiliateLinks    AffiliateLink[]
}

model RegistrarTld {
  id           String    @id @default(cuid())
  registrarId  String
  tldId        String
  supported    Boolean   @default(true)
  registrar    Registrar @relation(fields: [registrarId], references: [id], onDelete: Cascade)
  tld          Tld       @relation(fields: [tldId], references: [id], onDelete: Cascade)
  @@unique([registrarId, tldId])
}

model RegistrarFeature {
  id          String    @id @default(cuid())
  registrarId String
  name        String
  description String?
  included    Boolean   @default(true)
  registrar   Registrar @relation(fields: [registrarId], references: [id], onDelete: Cascade)
}

model Pricing {
  id                 String         @id @default(cuid())
  tldId              String
  registrarId        String
  currency           String         @default("USD")
  registrationPrice  Decimal        @db.Decimal(10, 2)
  renewalPrice       Decimal        @db.Decimal(10, 2)
  transferPrice      Decimal?       @db.Decimal(10, 2)
  redemptionPrice    Decimal?       @db.Decimal(10, 2)
  restorePrice       Decimal?       @db.Decimal(10, 2)
  privacyPrice       Decimal?       @db.Decimal(10, 2)
  emailPrice         Decimal?       @db.Decimal(10, 2)
  promoPrice         Decimal?       @db.Decimal(10, 2)
  promoCode          String?
  promoStart         DateTime?
  promoEnd           DateTime?
  sourceUrl          String?
  sourceType         String?        // api, scrape, manual, demo
  confidence         DataConfidence @default(DEMO)
  lastChecked        DateTime       @default(now())
  isDemo             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tld                Tld            @relation(fields: [tldId], references: [id], onDelete: Cascade)
  registrar          Registrar      @relation(fields: [registrarId], references: [id], onDelete: Cascade)

  @@unique([tldId, registrarId, currency])
  @@index([tldId])
  @@index([registrarId])
  @@index([registrationPrice])
  @@index([renewalPrice])
}

model PriceHistory {
  id          String    @id @default(cuid())
  tldId       String
  registrarId String
  priceType   PriceType
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("USD")
  timestamp   DateTime  @default(now())
  isDemo      Boolean   @default(true)

  tld         Tld       @relation(fields: [tldId], references: [id], onDelete: Cascade)
  registrar   Registrar @relation(fields: [registrarId], references: [id], onDelete: Cascade)

  @@index([tldId, registrarId, priceType])
  @@index([timestamp])
}

model Promotion {
  id              String    @id @default(cuid())
  registrarId     String
  code            String
  discount        String    // e.g. "20% off" or "$2 off"
  description     String?   @db.Text
  tldsCovered     String[]  // extensions or ["*"]
  appliesTo       String[]  // registration, renewal, transfer
  startDate       DateTime?
  endDate         DateTime?
  restrictions    String?   @db.Text
  affiliateUrl    String?
  isActive        Boolean   @default(true)
  isDemo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  registrar       Registrar @relation(fields: [registrarId], references: [id], onDelete: Cascade)
}

model TldLaunch {
  id                String    @id @default(cuid())
  tldId             String?
  extension         String
  name              String?
  launchDate        DateTime?
  sunriseStart      DateTime?
  sunriseEnd        DateTime?
  landrushStart     DateTime?
  landrushEnd       DateTime?
  generalAvailability DateTime?
  registry          String?
  status            TldStatus @default(PLANNED)
  notes             String?   @db.Text
  isDemo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tld               Tld?      @relation(fields: [tldId], references: [id])
}

model IdnTld {
  id          String  @id @default(cuid())
  tldId       String  @unique
  unicode     String
  punycode    String
  language    String?
  script      String?
  region      String?
  example     String?
  isDemo      Boolean @default(true)

  tld         Tld     @relation(fields: [tldId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  type        String   // availability, price_drop, new_tld, promo
  domain      String?
  tld         String?
  threshold   Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedDomain {
  id        String   @id @default(cuid())
  userId    String
  domain    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, domain])
}

model AffiliateLink {
  id          String    @id @default(cuid())
  registrarId String
  url         String
  campaign    String?
  subId       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  registrar   Registrar @relation(fields: [registrarId], references: [id], onDelete: Cascade)
}

model ClickTracking {
  id          String   @id @default(cuid())
  registrarId String?
  tld         String?
  domain      String?
  sourcePage  String?
  campaign    String?
  timestamp   DateTime @default(now())
  userAgent   String?
  ipHash      String?
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  keyHash   String   @unique
  name      String?
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiUsage {
  id        String   @id @default(cuid())
  apiKeyId  String?
  endpoint  String
  timestamp DateTime @default(now())
  status    Int?
}

model DataSource {
  id                  String    @id @default(cuid())
  name                String
  sourceUrl           String?
  dataType            String    // pricing, availability, metadata, registry
  lastSuccessfulUpdate DateTime?
  lastFailedUpdate    DateTime?
  status              String    @default("unknown") // ok, failed, stale
  errorMessage        String?   @db.Text
  updateFrequency     String?
  method              String?   // api, scrape, manual
  isDemo              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?  @db.Text
  content     String   @db.Text
  category    String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DataUpdateLog {
  id        String   @id @default(cuid())
  source    String
  status    String
  message   String?  @db.Text
  records   Int?
  timestamp DateTime @default(now())
}
