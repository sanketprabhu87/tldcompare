# =============================================================================
# TLD Compare — Environment (never commit real secrets)
# =============================================================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server only — never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Demo mode: when true, mock provider is used and UI labels DEMO DATA
# Set false only after live provider credentials are verified
DEMO_MODE="true"

# Optional live providers (leave empty until approved access)
# Cloudflare Registrar — https://developers.cloudflare.com/registrar/registrar-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# GoDaddy Domains API — https://developer.godaddy.com/
GODADDY_API_KEY=
GODADDY_API_SECRET=
# GODADDY_API_BASE=https://api.godaddy.com  (or OTE sandbox URL)

# Namecheap API — https://www.namecheap.com/support/api/intro/
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=

# Cron (Vercel Cron Authorization header)
CRON_SECRET=

# Optional analytics / monitoring
NEXT_PUBLIC_ANALYTICS_ID=
SENTRY_DSN=
