# Database (PostgreSQL — use Neon, Supabase, or any Postgres)
DATABASE_URL="postgresql://user:password@host:5432/tldcompare?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/tldcompare?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-secret-here"

# Optional: Redis for caching
REDIS_URL=

# Analytics
GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GA_ID=

# Currency conversion (optional)
CURRENCY_API_KEY=

# Registrar API keys (add when connecting live providers)
# REGISTRAR_API_KEY_NAMECHEAP=
# REGISTRAR_API_KEY_PORKBUN=
# REGISTRAR_API_KEY_CLOUDFLARE=

# Affiliate IDs
# AFFILIATE_ID_NAMECHEAP=
# AFFILIATE_ID_PORKBUN=

# Cron secret for scheduled jobs
CRON_SECRET=

# Email (for alerts)
EMAIL_PROVIDER_API_KEY=
