{
  "name": "tldcompare",
  "version": "2.0.0",
  "private": true,
  "description": "TLD Compare — domain extension & registrar comparison platform (Next.js + Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
